<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="dynamic_snippet_latest_archive_recipe_filter" model="ir.filters">
            <field name="name">Latest Archive Recipes</field>
            <field name="model_id">bakers_archive.recipe</field>
            <field name="user_ids" eval="False" />
            <field name="domain">[('published_date', '&lt;=', 'now')]</field>
            <field name="sort">["published_date desc"]</field>
            <field name="action_id" ref="website.action_website"/>
        </record>
        <record id="dynamic_snippet_most_viewed_archive_recipe_filter" model="ir.filters">
            <field name="name">Most Viewed Archive Recipes</field>
            <field name="model_id">bakers_archive.recipe</field>
            <field name="user_ids" eval="False" />
            <field name="domain">[('published_date', '&lt;=', 'now'), ('visits', '!=', False)]</field>
            <field name="sort">["visits desc"]</field>
            <field name="action_id" ref="website.action_website"/>
        </record>
        <record id="dynamic_filter_latest_archive_recipes" model="website.snippet.filter">
            <field name="name">Latest Archives Recipes</field>
            <field name="filter_id" ref="bakers_archive.dynamic_snippet_latest_archive_recipe_filter"/>
            <field name="field_names">name,teaser,subtitle</field>
            <field name="limit" eval="16"/>
        </record>
        <record id="dynamic_filter_most_viewed_archive_recipes" model="website.snippet.filter">
            <field name="name">Most Viewed Archive Recipes</field>
            <field name="filter_id" ref="bakers_archive.dynamic_snippet_most_viewed_archive_recipe_filter"/>
            <field name="field_names">name,teaser,subtitle</field>
            <field name="limit" eval="16"/>
        </record>
    </data>
</odoo>
