<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="bakers_archive.archiveRecipePageOption">
    <BuilderContext action="'websiteConfig'">
        <BuilderRow label.translate="Top Banner">
            <BuilderCheckbox id="'archive_cover_opt'"
                             actionParam="{views: ['bakers_archive.opt_archive_cover_recipe']}"/>
        </BuilderRow>
        <BuilderRow label.translate="Full-Width" t-if="isActiveItem('archive_cover_opt')" level="1">
            <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_archive_cover_recipe_fullwidth_design']}"/>
        </BuilderRow>
        <BuilderRow label.translate="Layout">
            <BuilderSelect>
                <BuilderSelectItem actionParam="{views: []}">Grid</BuilderSelectItem>
                <BuilderSelectItem
                        actionParam="{views: ['bakers_archive.opt_archive_list_view']}">List</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
        <BuilderRow label.translate="Cards" level="1">
            <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_archive_cards_design']}"/>
        </BuilderRow>
        <BuilderRow label.translate="Increase Readability" level="1">
            <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_archive_readable']}"/>
        </BuilderRow>
        <BuilderRow label.translate="Sidebar">
            <BuilderCheckbox id="'archive_recipes_sidebar_opt'"
                             actionParam="{views: ['bakers_archive.opt_archive_sidebar_show']}"/>
        </BuilderRow>
        <t t-if="isActiveItem('archive_recipes_sidebar_opt')">
            <BuilderRow label.translate="Archives" level="1">
                <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_sidebar_archive_index_archives']}"/>
            </BuilderRow>
            <BuilderRow label.translate="Follow Us" level="1">
                <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_sidebar_archive_index_follow_us']}"/>
            </BuilderRow>
            <BuilderRow label.translate="Tags List" level="1">
                <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_sidebar_archive_index_tags']}"/>
            </BuilderRow>
        </t>
        <BuilderRow label.translate="Recipes List">
            <BuilderSelect>
                <BuilderSelectItem actionParam="{views: []}">No Cover</BuilderSelectItem>
                <BuilderSelectItem
                        actionParam="{views: ['bakers_archive.opt_recipes_loop_show_cover']}">Cover</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
        <BuilderRow label.translate="Author" level="1">
            <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_recipes_loop_show_author']}"/>
        </BuilderRow>
        <BuilderRow label.translate="Comments/Views Stats" level="1">
            <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_recipes_loop_show_stats']}"/>
        </BuilderRow>
        <BuilderRow label.translate="Teaser &amp; Tags" level="1">
            <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_recipes_loop_show_teaser']}"/>
        </BuilderRow>
    </BuilderContext>
</t>

</templates>
