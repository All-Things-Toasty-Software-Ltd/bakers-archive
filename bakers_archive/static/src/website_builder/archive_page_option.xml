<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="bakers_archive.ArchivePageOption">
    <BuilderContext action="'websiteConfig'">
        <BuilderRow label.translate="Layout">
            <BuilderSelect>
                <BuilderSelectItem actionParam="{views: ['bakers_archive.opt_archive_recipe_regular_cover']}">Title Above Cover</BuilderSelectItem>
                <BuilderSelectItem actionParam="{views: []}">Title Inside Cover</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>

        <BuilderRow label.translate="Increase Readability" level="1">
            <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_archive_recipe_readable']}"/>
        </BuilderRow>

        <BuilderRow label.translate="Sidebar">
            <BuilderCheckbox id="'archive_recipe_sidebar_opt'" actionParam="{views: ['bakers_archive.opt_archive_recipe_sidebar']}"/>
        </BuilderRow>

        <t t-if="this.isActiveItem('archive_recipe_sidebar_opt')">
            <BuilderRow label.translate="Archive" level="1">
                <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_archive_recipe_archive_display']}"/>
            </BuilderRow>

            <BuilderRow label.translate="Author" level="1">
                <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_archive_recipe_author_avatar_display']}"/>
            </BuilderRow>

            <BuilderRow label.translate="Archives List" level="1">
                <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_archive_recipe_archives_display']}"/>
            </BuilderRow>

            <BuilderRow label.translate="Share Links" level="1">
                <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_archive_recipe_share_links_display']}"/>
            </BuilderRow>

            <BuilderRow label.translate="Tags" level="1">
                <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_archive_recipe_tags_display']}"/>
            </BuilderRow>
        </t>

        <BuilderRow label.translate="Breadcrumb">
            <BuilderCheckbox actionParam="{views: ['bakers_archive.opt_archive_recipe_breadcrumb']}"/>
        </BuilderRow>

        <BuilderRow label.translate="Bottom">
            <BuilderButton label.translate="Next Article" actionParam="{views: ['bakers_archive.opt_archive_recipe_read_next']}"/>
            <BuilderButton label.translate="Comments" actionParam="{views: ['bakers_archive.opt_archive_recipe_comment']}"/>
        </BuilderRow>
    </BuilderContext>
</t>
</templates>
