<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="index" name="Archive Navigation">
        <t t-call="website.layout">
            <div id="wrap" class="js_archive bakers_archive">
                <t t-out="0"/>

                <t t-set="oe_structure_archive_footer_description">Visible in all archives' pages</t>
                <div class="oe_structure oe_empty oe_structure_not_nearest"
                     id="oe_structure_archive_footer"
                     t-att-data-editor-sub-message="oe_structure_archive_footer_description"/>
            </div>
        </t>
    </template>

    <template id="archive_recipe_short" name="Archive Recipes">
        <t t-set="head">
            <link t-if="archive" t-att-href="'/bakers-archive/%s/feed' % slug(archive)" type="application/atom+xml"
                  rel="alternate"
                  title="Atom Feed"/>
            <meta t-if="active_tag_ids" name="robots" t-attf-content="none"/>
        </t>
        <t t-call="bakers_archive.index"
           head="head"
           opt_archive_readable="is_view_active('bakers_archive.opt_archive_readable')">

            <t t-set="opt_archive_cards_design" t-value="is_view_active('bakers_archive.opt_archive_cards_design')"/>
            <t t-set="opt_archive_list_view" t-value="is_view_active('bakers_archive.opt_archive_list_view')"/>
            <t t-set="opt_archive_sidebar_show" t-value="is_view_active('bakers_archive.opt_archive_sidebar_show')"/>

            <div id="o_barchive_archive_top">
                <t t-if="not tag and not date_begin and not search">
                    <div id="o_barchive_archive_top_droppable"/>
                    <t t-if="archive">
                        <div t-field="archive.content"
                             t-attf-data-editor-sub-message.translate="Edit the '{{archive.name}}' page header."/>
                    </t>
                    <t t-elif="archives">
                        <div class="oe_structure"
                             data-editor-sub-message.translate="Edit the 'All Archives' page header."/>
                    </t>
                </t>
                <t t-else="">
                    <div class="oe_structure"
                         id="oe_structure_archive_filtered_header"
                         data-editor-sub-message.translate="Edit the 'Filter Results' page header."/>
                </t>
            </div>

            <t t-call="bakers_archive.archives_nav"
               search="original_search or search"
               additional_classes.f="mt-3"/>

            <section id="o_barchive_index_content"
                     t-att-class="opt_archive_cards_design and 'o_barchive_page_cards_bg'">
                <div class="container py-4">
                    <div t-if="original_search and recipes" class="alert alert-warning mt8">
                        No results found for '<span t-out="original_search"/>'. Showing results for '<span
                            t-out="search"/>'.
                    </div>
                    <div t-attf-class="row #{opt_archive_sidebar_show and 'justify-content-between' or 'justify-content-center'}">
                        <div id="o_barchive_recipes_loop_container"
                             t-attf-class="col #{'o_container_small mx-0' if opt_archive_list_view else ''}">

                            <t t-if="not archive" t-set="recipes_list_show_parent_archive" t-value="True"/>
                            <t t-call="bakers_archive.recipes_loop"
                               recipes_list_show_parent_archive="recipes_list_show_parent_archive"/>

                            <t t-call="website.pager" classname.f="justify-content-center"
                               extraLinkClass.f="recipe_link"/>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="opt_archive_cover_recipe" name="Top banner - Name / Latest recipe"
              inherit_id="bakers_archive.archive_recipe_short"
              active="True" priority="17">
        <xpath expr="//div[@id='o_barchive_archive_top_droppable']" position="replace">
            <div class="container">
                <div class="row py-4">
                    <t t-if="archive">
                        <div t-attf-class="mb-3 mb-md-0 #{'col-md-5' if (not opt_archive_list_view and not opt_archive_sidebar_show) else 'col-md-6'}">
                            <t t-call="website.record_cover"
                               _record="archive"
                               additionnal_classes.f="h-100 py-5 py-md-0 overflow-hidden rounded shadow"/>
                        </div>
                        <div t-att-class="'col-md-7' if (not opt_archive_list_view and not opt_archive_sidebar_show) else 'col-md-6'">
                            <div class="container position-relative h-100 d-flex flex-column justify-content-around pt-1 pb-2">
                                <div t-attf-class="o_barchive_recipe_title">
                                    <span t-field="archive.name" class="h1 d-block" placeholder="Archive's Title"/>
                                    <div t-field="archive.subtitle" class="h4" placeholder="Subtitle"/>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="h1" style="text-align:center;">Our Latest Recipes</div>
                    </t>
                    <div class="col-12 mt-3">
                        <hr/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="opt_archive_cover_recipe_fullwidth_design" name="Full-Width Cover"
              inherit_id="bakers_archive.opt_archive_cover_recipe" active="True">
        <xpath expr="//div[hasclass('container')]" position="replace">
            <t t-if="archive" t-call="website.record_cover"
               _record="archive"
               use_filters="True"
               use_text_align="True"
               additionnal_classes.f="o_barchive_recipe_page_cover o_record_has_cover cover_auto">
                <div class="container position-relative h-100 d-flex flex-column justify-content-around">
                    <div t-attf-class="o_barchive_recipe_title">
                        <span t-att-title="archive.name" class="text-white text-decoration-none">
                            <h1 t-field="archive.name" class="o_barchive_recipe_name" placeholder="Archive Title"/>
                            <div t-field="archive.subtitle" class="o_barchive_recipe_subtitle"
                                 placeholder="Archive Subtitle"/>
                        </span>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="h1 my-4" style="text-align:center;">Our Latest Recipes</div>
            </t>
        </xpath>
    </template>


    <template id="opt_archive_sidebar_show" name="Show Sidebar" inherit_id="bakers_archive.archive_recipe_short"
              active="False">
        <xpath expr="//div[@id='o_barchive_recipes_loop_container']" position="after">
            <div t-attf-class="col-12 col-md-3 d-flex #{opt_archive_list_view and 'col-lg-4' or 'ms-lg-5'}">
                <t t-call="bakers_archive.sidebar_archive_index"/>
            </div>
        </xpath>
    </template>


    <template id="opt_archive_cards_design" name="'Cards' Design" inherit_id="bakers_archive.archive_recipe_short"
              active="False"/>


    <template id="opt_archive_list_view" name="List View" inherit_id="bakers_archive.archive_recipe_short"
              active="False"/>


    <template id="opt_archive_readable" name="Increase Readability" inherit_id="bakers_archive.archive_recipe_short"
              active="True"/>


    <template id="bakers_archive.archive_recipe_complete" name="archive recipe" track="1">
        <t t-call="bakers_archive.index">

            <t t-set="opt_archive_recipe_regular_cover"
               t-value="is_view_active('bakers_archive.opt_archive_recipe_regular_cover')"/>
            <t t-set="opt_archive_recipe_breadcrumb"
               t-value="is_view_active('bakers_archive.opt_archive_recipe_breadcrumb')"/>

            <t t-set="opt_archive_recipe_readable"
               t-value="is_view_active('bakers_archive.opt_archive_recipe_readable')"/>
            <t t-set="opt_archive_recipe_sidebar"
               t-value="is_view_active('bakers_archive.opt_archive_recipe_sidebar')"/>

            <div class="container my-4">
                <t t-if="opt_archive_recipe_breadcrumb" t-call="bakers_archive.recipe_breadcrumbs"
                   additionnal_classes.f="mb-3 bg-transparent"/>

                <div class="card bg-transparent border p-3 p-md-4 rounded-3 shadow-sm">

                    <section id="o_barchive_recipe_top" class="mb-3">
                        <div id="title" class="archive_header" t-ignore="True">
                            <div class="d-flex flex-column flex-md-row align-items-start gap-4">
                                <!-- Bread Image -->
                                <div class="flex-shrink-0">
                                    <span t-field="archive_recipe.image_1920"
                                          t-options="{'widget': 'image', 'class': 'img img-fluid rounded shadow-sm', 'style': 'max-width: 140px; height: auto;'}"/>
                                </div>

                                <div class="flex-grow-1 w-100">
                                    <div t-attf-class="o_barchive_recipe_title mb-2">
                                        <h1 t-field="archive_recipe.name" class="o_barchive_recipe_name fw-bold mb-1"
                                            placeholder="Archive Recipe Title"/>
                                        <div t-if="archive_recipe.subtitle" t-field="archive_recipe.subtitle"
                                             class="o_barchive_recipe_subtitle text-muted" placeholder="Subtitle"/>
                                    </div>

                                    <t t-call="bakers_archive.archive_recipe_info"/>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section id="o_barchive_recipe_main"
                             t-attf-class="pt-2 #{'anim' in request.params and 'o_barchive_recipe_main_transition'}">
                        <div t-if="opt_archive_recipe_sidebar"
                             t-attf-class="mx-auto #{opt_archive_recipe_readable and 'o_barchive_read_with_sidebar'}">
                            <div t-attf-class="d-flex flex-column flex-lg-row #{opt_archive_recipe_readable and 'justify-content-between'}">
                                <div id="o_barchive_recipe_content"
                                     t-attf-class="#{opt_archive_recipe_readable and 'o_container_small mx-0 w-100 flex-shrink-0' or 'w-lg-75'}">
                                    <t t-call="bakers_archive.archive_recipe_content"
                                       opt_archive_recipe_regular_cover="opt_archive_recipe_regular_cover"
                                       opt_archive_recipe_breadcrumb="opt_archive_recipe_breadcrumb"/>
                                </div>
                                <div id="o_barchive_recipe_sidebar_col"
                                     t-attf-class="ps-lg-5 #{not opt_archive_recipe_readable and 'flex-grow-1 w-lg-25'}">
                                    <t t-call="bakers_archive.archive_recipe_sidebar"/>
                                </div>
                            </div>
                        </div>

                        <div t-if="not opt_archive_recipe_sidebar"
                             t-attf-class="#{opt_archive_recipe_readable and 'o_container_small'}">
                            <div class="d-flex flex-column flex-lg-row">
                                <div id="o_barchive_recipe_content"
                                     t-attf-class=" #{opt_archive_recipe_readable and 'o_container_small w-100 flex-shrink-0'}">
                                    <t t-call="bakers_archive.archive_recipe_content"
                                       opt_archive_recipe_regular_cover="opt_archive_recipe_regular_cover"
                                       opt_archive_recipe_breadcrumb="opt_archive_recipe_breadcrumb"/>
                                </div>
                            </div>
                        </div>
                    </section>

                </div>
            </div>

            <section id="o_barchive_recipe_footer"/>
        </t>
    </template>

    <template id="archive_recipe_content" name="archive recipe content">
        <t t-if="opt_archive_recipe_breadcrumb and not opt_archive_recipe_regular_cover"
           t-call="bakers_archive.recipe_breadcrumbs"
           additionnal_classes.f="mb-3 bg-transparent"/>
        <t t-if="not opt_archive_recipe_regular_cover">
            <t t-call="bakers_archive.archive_recipe_info"/>
        </t>
        <t t-set="editor_message">BAKE HERE</t>
        <div t-field="archive_recipe.content"
             t-att-data-editor-message="editor_message"
             t-attf-class="o_barchive_recipe_content_field #{'o_barchive_read_text' if opt_archive_recipe_readable else ''}"/>

        <div t-if="len(archives) > 1 or len(archive_recipe.tag_ids) > 0" class="css_editable_mode_hidden text-muted">
            <div t-if="len(archives) > 1">in
                <a t-attf-href="#{archive_url(archive=archive_recipe.archive_id)}">
                    <b t-field="archive.name"/>
                </a>
            </div>
            <div t-if="len(archive_recipe.tag_ids) > 0">#
                <t t-foreach="archive_recipe.tag_ids" t-as="one_tag">
                    <a t-attf-class="badge me-1 o_tag o_color_#{one_tag.colour} recipe_link"
                       t-attf-href="#{archive_url(tag=slug(one_tag), date_begin=False, date_end=False)}"
                       t-out="one_tag.name"/>
                </t>
            </div>
        </div>
    </template>


    <template id="opt_archive_recipe_readable" name="Increase Readability"
              inherit_id="bakers_archive.archive_recipe_complete"
              active="True"/>


    <template id="opt_archive_recipe_sidebar" name="Show Sidebar" inherit_id="bakers_archive.archive_recipe_complete"
              active="False"/>


    <template id="opt_archive_recipe_regular_cover" name="'Regular' Cover"
              inherit_id="bakers_archive.archive_recipe_complete"
              active="False"/>

    <template id="opt_archive_recipe_breadcrumb" name="Show Breadcrumb"
              inherit_id="bakers_archive.archive_recipe_complete"
              active="True"/>


    <template id="opt_archive_recipe_comment" name="Allow Comments" inherit_id="bakers_archive.archive_recipe_complete"
              active="False">
        <xpath expr="//section[@id='o_barchive_recipe_main']" position="inside">
            <t t-set="readableClass" t-if="opt_archive_recipe_readable and opt_archive_recipe_sidebar"
               t-value="'o_barchive_read_with_sidebar'"/>
            <t t-set="readableClass" t-elif="opt_archive_recipe_readable" t-value="'o_container_small'"/>

            <div class="container">
                <div t-attf-class="mx-auto #{readableClass}">
                    <div id="o_barchive_recipe_comments" t-attf-class="pt-4 o_container_small">
                        <div groups="base.group_public" class="small mb-4">
                            <a t-attf-href="/web/login?redirect=/bakers-archive/{{slug(archive_recipe.archive_id)}}/{{slug(archive_recipe)}}#discussion"
                               class="btn btn-sm btn-primary">
                                <b>Sign in</b>
                            </a>
                            to leave a comment
                        </div>
                        <t t-call="portal.message_thread" object="archive_recipe"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="opt_archive_recipe_read_next" name="Read Next Recipe"
              inherit_id="bakers_archive.archive_recipe_complete"
              active="True">
        <xpath expr="//section[@id='o_barchive_recipe_footer']" position="inside">
            <div t-if="next_recipe" class="mt-5">
                <t t-if="opt_archive_recipe_regular_cover">
                    <t t-if="opt_archive_recipe_sidebar" t-set="readableClass"
                       t-value="'o_barchive_read_with_sidebar'"/>
                    <t t-else="" t-set="readableClass" t-value="'o_container_small'"/>

                    <div class="container">
                        <div t-attf-class="mb-4 mx-auto #{ readableClass if opt_archive_recipe_readable else ''}">
                            <hr/>
                            <div class="d-flex text-end py-4">
                                <div class="flex-grow-1 pe-3">
                                    <span class="bg-o-color-3 h6 d-inline-block py-1 px-2 rounded-1">Read Next</span>
                                    <a t-att-href="'/bakers-archive/' + slug(next_recipe.archive_id) + '/' + slug(next_recipe)"
                                       t-att-title="'Read next' + next_recipe.name">
                                        <div t-field="next_recipe.name" t-att-data-archive-id="next_recipe.id"
                                             placeholder="Archive Recipe Title" class="h2 o_barchive_recipe_name"/>
                                        <div t-field="next_recipe.subtitle" placeholder="Subtitle"
                                             class="lead o_barchive_recipe_subtitle"/>
                                    </a>
                                </div>
                                <a t-att-href="'/bakers-archive/' + slug(next_recipe.archive_id) + '/' + slug(next_recipe)"
                                   t-att-title="'Read next' + next_recipe.name" class="w-25 flex-shrink-0">
                                    <t t-call="website.record_cover"
                                       _record="next_recipe"
                                       additionnal_classes.f="rounded shadow-sm overflow-hidden h-100"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div id="o_barchive_next_container" class="d-flex flex-column">
                        <button aria-labelledby="o_barchive_next_title"
                                class="o_barchive_next_button o_button_area btn z-1"/>
                        <t t-call="website.record_cover"
                           _record="next_recipe"
                           use_filters="True"
                           additionnal_classes.f="o_barchive_recipe_page_cover o_barchive_recipe_page_cover_footer o_record_has_cover">
                            <t t-set="_cp" t-value="json.loads(_record.cover_properties)"/>

                            <a id="o_barchive_next_recipe_info" class="d-none"
                               t-att-data-size="_cp.get('resize_class')"
                               t-att-data-url="'/bakers-archive/' + slug(next_recipe.archive_id) + '/' + slug(next_recipe) + '?anim'"/>

                            <t t-set="next_cover_is_full"
                               t-value="bool({'o_full_screen_height', 'cover_full'}.intersection(_cp.get('resize_class', '').split(' ')))"/>
                            <t t-set="next_cover_is_auto" t-value="'cover_auto' in _cp.get('resize_class', '')"/>

                            <div class="container text-center position-relative h-100 d-flex flex-column flex-grow-1 justify-content-around">
                                <div id="o_barchive_next_title" class="o_barchive_recipe_title">
                                    <div t-field="next_recipe.name" t-att-data-archive-id="next_recipe.id"
                                         placeholder="Archive Recipe Title" class="h1 o_barchive_recipe_name"/>
                                    <div t-field="next_recipe.subtitle" class="o_barchive_recipe_subtitle"
                                         placeholder="Subtitle"/>
                                </div>

                                <div t-attf-class="o_barchive_toggle #{next_cover_is_full and 'mb-n5'}">
                                    <span class="h4 d-inline-block py-1 px-2 rounded-1 text-white">
                                        <i class="fa fa-angle-right fa-3x text-white" aria-label="Read next"
                                           title="Read Next"/>
                                    </span>
                                </div>


                                <div
                                        t-if="not next_cover_is_auto"
                                        class="o_barchive_next_loader o_barchive_toggle justify-content-center align-items-center mx-auto position-relative d-none">
                                    <div class="rounded-circle bg-black-50"></div>
                                </div>
                                <div t-else="" class="o_barchive_next_fake_btn d-flex o_barchive_toggle"/>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </xpath>
    </template>


    <template id="archive_feed">&lt;?xml version="1.0" encoding="utf-8"?&gt;
        <feed t-att-xmlns="'http://www.w3.org/2005/Atom'">
            <title t-out="archive.name"/>
            <link t-att-href="'%s/bakers-archive/%s' % (base_url ,archive.id)"/>
            <id t-out="'%s/bakers-archive/%s' % (base_url, archive.id)"/>
            <updated
                    t-out="str(recipes[0].published_date).replace(' ', 'T') + 'Z' if recipes and recipes[0].published_date else ''"/>
            <entry t-foreach="recipes" t-as="recipe">
                <title t-out="recipe.name"/>
                <link t-att-href="'%s%s' % (base_url, recipe.website_url)"/>
                <id t-out="'%s%s' % (base_url, recipe.website_url)"/>
                <author>
                    <name t-out="recipe.sudo().author_id.name"/>
                </author>
                <summary t-out="html2plaintext(recipe.teaser)"/>
                <updated t-out="recipe.published_date and str(recipe.published_date).replace(' ', 'T') + 'Z' or ''"/>
            </entry>
        </feed>
    </template>

    <template id="robots" inherit_id="website.robots">
        <xpath expr="//t[@id='robots_module_rules']" position="inside">
            <t t-translation="off">
                User-agent: *
                Disallow: /bakers-archive/*/feed
            </t>
        </xpath>
    </template>

</odoo>
