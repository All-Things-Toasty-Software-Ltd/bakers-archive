<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="bakers_archive_recipe_view_form_add" model="ir.ui.view">
    <field name="name">bakers_archive.recipe.view.form.add</field>
    <field name="model">bakers_archive.recipe</field>
    <field name="arch" type="xml">
        <form js_class="website_new_content_form">
            <group>
                <field name="website_url" invisible="1"/>
                <field name="archive_id" string="Select Archive"/>
                <field name="name" placeholder="Archive Recipe Title"/>
            </group>
        </form>
    </field>
</record>

<record id="bakers_archive_recipe_action_add" model="ir.actions.act_window">
    <field name="name">New Archive Recipe</field>
    <field name="res_model">bakers_archive.recipe</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="view_id" ref="bakers_archive_recipe_view_form_add"/>
</record>

</odoo>