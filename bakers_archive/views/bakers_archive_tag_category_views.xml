<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bakers_archive_tag_category_tree" model="ir.ui.view">
        <field name="name">bakers_archive.tag.category.list</field>
        <field name="model">bakers_archive.tag.category</field>
        <field name="arch" type="xml">
            <list string="Tag Categories">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="bakers_archive_tag_category_form" model="ir.ui.view">
        <field name="name">bakers_archive.tag.category.form</field>
        <field name="model">bakers_archive.tag.category</field>
        <field name="arch" type="xml">
            <form string="Tag Category Form">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bakers_archive_tag_category_action" model="ir.actions.act_window">
        <field name="name">Tag Categories</field>
        <field name="res_model">bakers_archive.tag.category</field>
        <field name="path">archive-tag-categories</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="bakers_archive_tag_category_tree"/>
    </record>
</odoo>