<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bakers_archive_recipe_tree" model="ir.ui.view">
        <field name="name">bakers_archive.recipe.list</field>
        <field name="model">bakers_archive.recipe</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list js_class="website_pages_list" type="object" action="open_website_url" multi_edit="1">
                <field name="name"/>
                <field name="website_url"/>

                <field name="author_id" optional="show"/>
                <field name="archive_id" optional="hide"/>
                <field name="create_uid" optional="hide"/>
                <field name="write_uid" optional="hide"/>
                <field name="write_date" optional="hide"/>

                <field name="is_seo_optimized"/>
                <field name="website_published" invisible="publish_on and website_published"/>
                <field name="publish_on" string="Scheduled" invisible="not publish_on"/>

                <field name="website_id" groups="website.group_multi_website"/>
            </list>
        </field>
    </record>

    <record id="bakers_archive_recipe_kanban" model="ir.ui.view">
        <field name="name">bakers_archive.recipe.kanban</field>
        <field name="model">bakers_archive.recipe</field>
        <field name="arch" type="xml">
            <kanban js_class="website_pages_kanban" class="o_kanban_mobile" action="open_website_url" type="object"
                    sample="1">
                <field name="published_date"/>
                <field name="publish_on"/>
                <templates>
                    <t t-name="card">
                        <t t-name="card">
                            <div class="row mb-auto">
                                <div class="col-8 fw-bolder">
                                    <field class="d-block text-truncate" name="name"/>
                                    <div class="text-muted" t-if="record.website_id.value"
                                         groups="website.group_multi_website">
                                        <i class="fa fa-globe me-1" title="Website"/>
                                        <field name="website_id"/>
                                    </div>
                                </div>
                                <field name="archive_id" class="col-4 text-end fw-bolder"/>
                                <div class="col-8">
                                    <i class="fa fa-clock-o me-1" role="img" aria-label="Recipe date"
                                       title="Recipe date"/>
                                    <t t-if="record.published_date.value">
                                        <field name="published_date"/>
                                    </t>
                                    <t t-elif="record.publish_on.value">
                                        <field name="publish_on"/>
                                    </t>
                                </div>
                                <div class="col-4 text-end" t-att-title="record.author_id.value">
                                    <field name="author_id" widget="image" options="{'preview_image': 'avatar_128'}"
                                           class="o_avatar rounded"/>
                                </div>
                            </div>
                            <div class="d-flex border-top mt-2 pt-2">
                                <field name="website_published" widget="boolean_toggle"/>
                                <t t-if="record.publish_on.raw_value">Scheduled</t>
                                <t t-elif="record.website_published.raw_value">Published</t>
                                <t t-else="">Not Published</t>
                            </div>
                        </t>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="bakers_archive_recipe_form" model="ir.ui.view">
        <field name="name">bakers_archive.recipe.form</field>
        <field name="model">bakers_archive.recipe</field>
        <field name="arch" type="xml">
            <form string="Archive Recipe">
                <header>
                    <button name="action_generate_content"
                            string="Generate Content"
                            type="object"
                            class="btn-primary"
                            icon="fa-magic"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="not active">
                        <field name="is_published" widget="website_redirect_button"/>
                    </div>
                    <field name="main_image" widget="image" class="oe_avatar"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" nolabel="1" placeholder="Archive Recipe Title"/>
                        </h1>
                    </div>
                    <group>
                        <group name="archive_details" string="Archive Options">
                            <field name="archive_id"/>
                            <field name="subtitle" placeholder="Archive Subtitle"/>
                            <field name="teaser" placeholder="Archive Teaser"
                                   help="Shown as preview on the /archive page"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'colour', 'on_tag_click': 'edit_color'}"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                        <group name="publishing_details" string="Publishing Options">
                            <field name="author_id"/>
                            <field name="create_date" groups="base.group_no_one"/>
                            <field name="visits"/>
                            <field name="write_uid"/>
                            <field name="write_date"/>
                            <field name="publish_on" invisible="1"/>
                            <field string="Published" name="website_published" widget="boolean_toggle"
                                   readonly="publish_on"/>
                            <label invisible="website_published" for="publish_on" string="Publish on"/>
                            <div invisible="website_published" class="o_row">
                                <field name="publish_on" widget="datetime"/>
                                <button name="action_unschedule" type="object" invisible="not publish_on">Unschedule
                                </button>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description and Notes">
                            <group>
                                <field name="description"/>
                                <field name="notes"/>
                            </group>
                        </page>
                        <page name="details" string="Details">
                            <group>
                                <field name="original_language_id"/>
                                <field name="country_id"/>
                                <field name="state_id"/>
                                <field name="source_id"/>
                                <field name="license"/>
                            </group>
                        </page>
                        <page string="Ingredients">
                            <field name="ingredient_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Instruction Categories">
                            <field name="category_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Instructions">
                            <field name="instruction_ids" context="{'default_recipe_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category_id"
                                           domain="[('recipe_id', '=', parent.id)]"
                                           context="{'default_recipe_id': parent.id}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Media">
                            <field name="media_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="media_type"/>
                                    <field name="image" widget="image" nolabel="1"
                                           attrs="{'invisible': [('media_type', '!=', 'image')]}"/>
                                    <field name="video_url"
                                           attrs="{'invisible': [('media_type', '!=', 'video_link')]}"/>
                                    <field name="other_link_url"
                                           attrs="{'invisible': [('media_type', '!=', 'other_link')]}"/>
                                    <field name="display_media" nolabel="1"/>
                                    <field name="description"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="media_type"/>
                                            <field name="sequence"/>
                                        </group>
                                        <group>
                                            <field name="image" widget="image"
                                                   attrs="{'invisible': [('media_type', '!=', 'image')]}"/>
                                            <field name="video_url"
                                                   attrs="{'invisible': [('media_type', '!=', 'video_link')]}"/>
                                            <field name="other_link_url"
                                                   attrs="{'invisible': [('media_type', '!=', 'other_link')]}"/>
                                        </group>
                                        <field name="description"/>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page name="seo" string="SEO" groups="base.group_no_one">
                            <group name="default_opengraph">
                                <field name="website_meta_title" string="Meta Title"/>
                                <field name="website_meta_description" string="Meta Description"/>
                                <field name="website_meta_keywords" string="Meta Keywords"
                                       help="Separate every keyword with a comma"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bakers_archive_recipe_search" model="ir.ui.view">
        <field name="name">bakers_archive.recipe.search</field>
        <field name="model">bakers_archive.recipe</field>
        <field name="arch" type="xml">
            <search string="Archive Recipe">
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <field name="name" string="Content"
                       filter_domain="['|', ('name','ilike',self), ('content','ilike',self)]"/>
                <field name="write_uid"/>
                <field name="archive_id"/>
                <group>
                    <filter string="Archive" name="group_by_archive" domain="[]" context="{'group_by': 'archive_id'}"/>
                    <filter string="Author" name="group_by_author" domain="[]" context="{'group_by': 'create_uid'}"/>
                    <filter string="Last Contributor" name="last_contributor" domain="[]"
                            context="{'group_by': 'write_uid'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bakers_archive_recipe_action" model="ir.actions.act_window">
        <field name="name">Archive Recipe Pages</field>
        <field name="res_model">bakers_archive.recipe</field>
        <field name="path">archive-recipe-pages</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('bakers_archive_recipe_tree')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('bakers_archive_recipe_kanban')}),
        ]"/>
        <field name="search_view_id" ref="bakers_archive_recipe_search"/>
        <field name="context">{'create_action': 'bakers_archive.bakers_archive_recipe_action_add'}</field>
    </record>
</odoo>