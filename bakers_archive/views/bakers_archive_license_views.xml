<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bakers_archive_license_tree" model="ir.ui.view">
        <field name="name">bakers_archive.license.list</field>
        <field name="model">bakers_archive.license</field>
        <field name="arch" type="xml">
            <list>
                <field name="license"/>
                <field name="short_name"/>
            </list>
        </field>
    </record>
    
    <record id="bakers_archive_license_form" model="ir.ui.view">
        <field name="name">bakers_archive.license.form</field>
        <field name="model">bakers_archive.license</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="license"/>
                        <field name="short_name"/>
                        <field name="url"
                               widget="url"/>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>

                        <page string="Recipes">
                            <field name="recipe_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bakers_archive_license_action" model="ir.actions.act_window">
        <field name="name">Licenses</field>
        <field name="res_model">bakers_archive.license</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>