<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bakers_archive_tag_tree" model="ir.ui.view">
        <field name="name">bakers_archive.tag.list</field>
        <field name="model">bakers_archive.tag</field>
        <field name="arch" type="xml">
            <list string="Tag List">
                <field name="name"/>
                <field name="category_id"/>
                <field name="colour" widget="color_picker"/>
                <field name="recipe_ids"/>
            </list>
        </field>
    </record>

    <record id="bakers_archive_tag_form" model="ir.ui.view">
        <field name="name">bakers_archive.tag.form</field>
        <field name="model">bakers_archive.tag</field>
        <field name="arch" type="xml">
            <form string="Tag Form">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="colour" widget="color_picker"/>
                    </group>
                    <label for="recipe_ids" string="Used in: "/>
                    <field name="recipe_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bakers_archive_tag_action" model="ir.actions.act_window">
        <field name="name">Archive Tags</field>
        <field name="res_model">bakers_archive.tag</field>
        <field name="path">archive-tags</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="bakers_archive_tag_tree"/>
    </record>
</odoo>