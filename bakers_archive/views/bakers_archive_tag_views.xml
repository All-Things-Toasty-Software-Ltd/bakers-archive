<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bakers_archive_tag_tree" model="ir.ui.view">
        <field name="name">bakers_archive.tag.list</field>
        <field name="model">bakers_archive.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="tag"/>
            </list>
        </field>
    </record>
    
    <record id="bakers_archive_tag_form" model="ir.ui.view">
        <field name="name">bakers_archive.tag.form</field>
        <field name="model">bakers_archive.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="tag"/>
                    </group>

                    <notebook>
                        <page string="Recipes">
                            <field name="recipe_id"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bakers_archive_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">bakers_archive.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>